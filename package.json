{
  "name": "detour-division",
  "private": true,
  "version": "0.1.0",
  "description": "Detour Division — an offline-first open-field tower defence game.",
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.sim.json && tsc -p tsconfig.app.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "bake-art": "node tools/bake-art.ts",
    "validate-levels": "node tools/validate-levels.ts",
    "gen-schema": "node tools/gen-schema.ts",
    "bench": "node tools/bench.ts",
    "gen-audio-manifest": "node tools/gen-audio-manifest.ts",
    "perf": "PERF=1 playwright test e2e/perf.spec.ts --project=chromium --workers=1"
  },
  "dependencies": {
    "@fontsource/fredoka": "5.3.0",
    "@fontsource/lilita-one": "5.3.0",
    "pixi.js": "8.21.0",
    "workbox-window": "7.4.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.6",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "5.0.1",
    "workbox-build": "7.4.1"
  }
}
